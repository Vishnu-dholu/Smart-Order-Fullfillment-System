{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "RSS Memory Footprint",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "process_resident_memory_bytes",
          "legendFormat": "{{instance}} (Go RSS)",
          "refId": "A"
        },
        {
          "expr": "sum(jvm_memory_used_bytes) by (instance)",
          "legendFormat": "{{instance}} (JVM Total Memory Used)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "unit": "bytes"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU Usage Rate",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "process_cpu_usage",
          "legendFormat": "{{instance}} (Spring)",
          "refId": "A"
        },
        {
          "expr": "rate(process_cpu_seconds_total[1m])",
          "legendFormat": "{{instance}} (Go)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "unit": "percentunit"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "P99 HTTP Latency Panel (Java vs Go)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket[1m])) by (le, instance))",
          "legendFormat": "{{instance}} (Spring)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(gin_request_duration_seconds_bucket[1m])) by (le, instance))",
          "legendFormat": "{{instance}} (Go)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "unit": "s"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP Throughput",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count[1m])) by (instance)",
          "legendFormat": "{{instance}} (Spring)",
          "refId": "A"
        },
        {
          "expr": "sum(rate(gin_request_duration_seconds_count[1m])) by (instance)",
          "legendFormat": "{{instance}} (Go)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "unit": "reqps"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "The Resource Footprint (Memory Churn)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\"}",
          "legendFormat": "{{instance}} (Spring Heap - {{id}})",
          "refId": "A"
        },
        {
          "expr": "go_memstats_heap_alloc_bytes",
          "legendFormat": "{{instance}} (Go Heap)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "unit": "bytes"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Garbage Collection Pauses (Java vs Go)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum[1m])",
          "legendFormat": "{{instance}} (JVM GC pause rate)",
          "refId": "A"
        },
        {
          "expr": "rate(go_gc_duration_seconds_sum[1m])",
          "legendFormat": "{{instance}} (Go GC pause rate)",
          "refId": "B"
        },
        {
          "expr": "rate(go_gc_duration_seconds_count[1m])",
          "legendFormat": "{{instance}} (Go GC cycles/sec)",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Go GC cycles/sec" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "custom.axisPlacement", "value": "right" }
            ]
          }
        ]
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "DB Connection Pool (HikariCP vs Go sql.DB)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "hikaricp_connections_active",
          "legendFormat": "{{instance}} (HikariCP Active)",
          "refId": "A"
        },
        {
          "expr": "hikaricp_connections_pending",
          "legendFormat": "{{instance}} (HikariCP Pending)",
          "refId": "B"
        },
        {
          "expr": "go_sql_in_use_connections",
          "legendFormat": "{{instance}} {{db_name}} (Go In-Use)",
          "refId": "C"
        },
        {
          "expr": "go_sql_open_connections",
          "legendFormat": "{{instance}} {{db_name}} (Go Open)",
          "refId": "D"
        },
        {
          "expr": "go_sql_idle_connections",
          "legendFormat": "{{instance}} {{db_name}} (Go Idle)",
          "refId": "E"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "unit": "short"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "The Concurrency Model (Threads vs. Goroutines)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "expr": "jvm_threads_live_threads",
          "legendFormat": "{{instance}} (Spring Threads)",
          "refId": "A"
        },
        {
          "expr": "go_goroutines",
          "legendFormat": "{{instance}} (Go Goroutines)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "unit": "short"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "HTTP Error Rate",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5.*\"}[1m])) by (instance)",
          "legendFormat": "{{instance}} (Spring Errors)",
          "refId": "A"
        },
        {
          "expr": "sum(rate(gin_request_duration_seconds_count{code=~\"5.*\"}[1m])) by (instance)",
          "legendFormat": "{{instance}} (Go Errors)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "unit": "reqps"
        }
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 36,
  "style": "dark",
  "tags": ["ssp"],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h",
      "2h",
      "1d"
    ]
  },
  "timezone": "",
  "title": "SSP Benchmarks",
  "version": 2
}
