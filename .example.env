# =============================================================================
# Smart Order Fulfillment System — Root Environment Template
# Copy this file to .env and fill in your values.
# Never commit the real .env file to version control.
# =============================================================================

# =============================================================================
# 🔐 Secrets & Auth
# =============================================================================
JWT_SECRET=your_jwt_secret_here
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# =============================================================================
# 🗄️ Java Service Databases (JDBC format)
# =============================================================================
AUTH_DB_URL=jdbc:postgresql://<host>/auth_db?user=<user>&password=<password>&sslmode=require
INVENTORY_DB_URL=jdbc:postgresql://<host>/inventory_db?user=<user>&password=<password>&sslmode=require
ORDER_DB_URL=jdbc:postgresql://<host>/order_db?user=<user>&password=<password>&sslmode=require

# =============================================================================
# 🗄️ Go Service Databases (PostgreSQL DSN format)
# =============================================================================
WAREHOUSE_DB_URL=postgresql://<user>:<password>@<host>/warehouse_db?sslmode=require&channel_binding=require
DELIVERY_DB_URL=postgresql://<user>:<password>@<host>/delivery_db?sslmode=require&channel_binding=require
NOTIFICATION_DB_URL=postgresql://<user>:<password>@<host>/notification_db?sslmode=require&channel_binding=require

# =============================================================================
# 📧 Email (SMTP) — used by notification-service
# =============================================================================
SMTP_EMAIL=your_smtp_email@example.com
SMTP_PASSWORD=your_smtp_app_password

# =============================================================================
# 🔑 Internal Service Auth
# =============================================================================
INTERNAL_SERVICE_TOKEN=your_internal_service_token
