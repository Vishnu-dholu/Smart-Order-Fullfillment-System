# ------------------------------------------------------------------------------
# Smart Order Fulfillment - Unified secret template (NO REAL VALUES)
# Copy to a private env file and inject from Jenkins/Ansible/Vault at runtime.
# ------------------------------------------------------------------------------

# Global security
JWT_SECRET=replace-with-64-byte-random-secret
INTERNAL_SERVICE_TOKEN=replace-with-strong-random-token

# OAuth
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
VITE_GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
VITE_API_GATEWAY_URL=http://localhost:8080/api

# Spring service DB URLs
AUTH_DB_URL=postgresql://<user>:<password>@<host>/auth_db?sslmode=require
ORDER_DB_URL=postgresql://<user>:<password>@<host>/order_db?sslmode=require
INVENTORY_DB_URL=postgresql://<user>:<password>@<host>/inventory_db?sslmode=require

# Go service DB URLs
WAREHOUSE_DB_URL=postgresql://<user>:<password>@<host>/warehouse_db?sslmode=require
DELIVERY_DB_URL=postgresql://<user>:<password>@<host>/delivery_db?sslmode=require
NOTIFICATION_DB_URL=postgresql://<user>:<password>@<host>/notification_db?sslmode=require

# Notification service
SMTP_EMAIL=no-reply@example.com
SMTP_PASSWORD=replace-with-app-password

# Service URLs (normally non-secret, but managed centrally for consistency)
AUTH_SERVICE_URL=http://auth-service:8081
INVENTORY_SERVICE_URL=http://inventory-service:8082
ORDER_SERVICE_URL=http://order-service:8083
WAREHOUSE_SERVICE_URL=http://warehouse-service:8084
DELIVERY_SERVICE_URL=http://delivery-service:8085
NOTIFICATION_SERVICE_URL=http://notification-service:8086
